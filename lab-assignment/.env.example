NEXT_PUBLIC_APP_NAME=ExamForge AI
NEXT_PUBLIC_APP_DESCRIPTION=AI-powered exam generation and grading for Grade 12 students.
NEXT_PUBLIC_APP_VERSION=0.1.0
NEXT_PUBLIC_MOCK_MODE=true
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# Optional backend AI providers. Leave empty to use the sample question bank.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
AI_PROVIDER_TIMEOUT_MS=25000

# Part 04 - API gateway controls
API_GATEWAY_ENABLED=true
API_GATEWAY_ALLOW_SAME_ORIGIN=true
API_GATEWAY_KEY=
NEXT_PUBLIC_API_GATEWAY_KEY=
JWT_SECRET=
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=30
COST_GUARD_ENABLED=true
COST_GUARD_TOKENS_PER_MINUTE=1000

# Part 05 - scaling/reliability
INSTANCE_ID=local-dev-1
